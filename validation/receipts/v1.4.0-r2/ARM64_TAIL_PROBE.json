  "distribution_policy_control_source": "#include <boost/math/distributions/skew_normal.hpp>\n#include <boost/math/policies/policy.hpp>\n#include <algorithm>\n#include <iostream>\n#include <iomanip>\nint main(){using P=boost::math::policies::policy<boost::math::policies::promote_double<false>>;std::cout<<std::setprecision(17);for(double a:{-10.,-2.,-.3,0.,.3,2.,10.})for(int i=-40;i<=40;++i){boost::math::skew_normal_distribution<double,P> f(0,1,a);double l=std::clamp(boost::math::cdf(f,double(i)),0.,1.);double r=std::clamp(boost::math::cdf(boost::math::complement(f,double(i))),0.,1.);std::cout<<a<<\",\"<<i<<\",\"<<std::min(1.,2*std::min(l,r))<<\"\\n\";}}\n",
