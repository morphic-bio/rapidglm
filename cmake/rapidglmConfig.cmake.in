@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Boost 1.65)
find_dependency(LAPACK)
set(_rapidglm_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(LAPACKE)
set(CMAKE_MODULE_PATH "${_rapidglm_module_path}")
unset(_rapidglm_module_path)
if(@RAPIDGLM_OPENMP@)
  find_dependency(OpenMP)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/rapidglmTargets.cmake")
